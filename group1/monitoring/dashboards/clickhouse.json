      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "",
              "limit": 1000,
              "mode": "list",
              "queryType": "table",
              "table": ""
            }
          },
          "pluginVersion": "4.17.0",
          "queryType": "table",
          "rawSql": "SELECT\n    hostName() AS node,\n    database,\n    table,\n    sum(rows) AS rows,\n    count() AS active_parts\nFROM clusterAllReplicas(\n    'production',\n    system.parts\n)\nWHERE active\n  AND database = 'ha'\nGROUP BY\n    node,\n    database,\n    table\nORDER BY\n    node,\n    database,\n    table",
          "refId": "A"
        }
      ],
      "title": "Rows by table (system.parts)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Number of ClickHouse queries per second calculated from the Query counter.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "qps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
